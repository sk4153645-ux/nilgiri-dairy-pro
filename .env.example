# Environment Configuration

# Database
DATABASE_PATH=data/dairy.db
DATABASE_RESET_ON_START=False

# Authentication
AUTH_ENABLE_DEMO=False
SESSION_TIMEOUT=3600
PASSWORD_MIN_LENGTH=6

# Gemini AI (For Register Scanning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# SMS/WhatsApp
SMS_PROVIDER=twilio  # or native for Android
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Default Values
DEFAULT_DAIRY_NAME=Nilgiri Dairy
DEFAULT_DAIRY_PHONE=+919876543210
DEFAULT_MILK_RATE=40.0
DEFAULT_SHIFT=Morning

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dairy.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Performance
DB_POOL_SIZE=5
DB_TIMEOUT=30
THREAD_POOL_SIZE=4

# Features
ENABLE_OFFLINE_SYNC=True
ENABLE_AUDIT_LOG=True
ENABLE_BACKUP=True
BACKUP_PATH=backups/
BACKUP_INTERVAL=86400  # 24 hours in seconds

# App
APP_NAME=Nilgiri Dairy Pro
APP_VERSION=1.0.0
DEBUG=False
